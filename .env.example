# Copy to .env.local for development, or set these in the host's environment.
# Never commit real values.

# Admin sign-in (/admin). One owner account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# A long random string, e.g. from: openssl rand -base64 48
AUTH_SECRET=
# How long a sign-in lasts, in hours (default 12).
ADMIN_SESSION_HOURS=12

# Database and private file storage. Without these, data is kept in .data/
# on this computer, which is for development only.
# Run supabase/migrations/20261118000000_admin.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The live public address, used in email links and PageSpeed tests.
SITE_URL=

# Email alerts for new leads and applications, through Resend (optional).
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=

# Also post every lead as JSON to this address (optional).
LEAD_WEBHOOK_URL=

# Google PageSpeed Insights API key (optional; avoids rate limits).
PAGESPEED_API_KEY=
